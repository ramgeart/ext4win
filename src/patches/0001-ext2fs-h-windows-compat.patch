Guard ext2fs.h so it pulls in windows_compat.h on Windows builds.

Without this, code that includes ext2fs.h will not see ssize_t, S_ISLNK,
etc. on Windows/MinGW-w64.

--- a/lib/ext2fs/ext2fs.h
+++ b/lib/ext2fs/ext2fs.h
@@ -1,6 +1,13 @@
 /*
  * ext2fs.h --- ext2fs
  *
+ * Include the Windows POSIX-compatibility shims before anything else
+ * when compiling on Win32.
+ */
+#ifdef _WIN32
+#include "windows_compat.h"
+#endif
