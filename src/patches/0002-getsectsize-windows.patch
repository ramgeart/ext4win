Replace POSIX ioctl calls in getsectsize.c with Win32 equivalents.

On Linux the sector size is queried via ioctl(BLKSSZGET).  Windows has
no such ioctl; use DeviceIoControl(IOCTL_STORAGE_QUERY_PROPERTY) for
block devices and fall back to 512 for image files.

--- a/lib/ext2fs/getsectsize.c
+++ b/lib/ext2fs/getsectsize.c
@@ -1,6 +1,13 @@
 /*
  * getsectsize.c --- get the sector size of a device.
  */
+#ifdef _WIN32
+#include "windows_compat.h"
+#include <windows.h>
+#include <winioctl.h>
+#endif
+
 #ifndef _GNU_SOURCE
 #define _GNU_SOURCE
 #endif
@@ -29,6 +36,42 @@ int ext2fs_get_device_sectsize(const char *file, int *sectsize)
 {
 	int	fd;
 
+#ifdef _WIN32
+	HANDLE hFile;
+	STORAGE_PROPERTY_QUERY query;
+	STORAGE_ACCESS_ALIGNMENT_DESCRIPTOR alignment;
+	DWORD bytes_returned;
+
+	hFile = CreateFileA(file, 0,
+	                    FILE_SHARE_READ | FILE_SHARE_WRITE,
+	                    NULL, OPEN_EXISTING,
+	                    FILE_ATTRIBUTE_NORMAL, NULL);
+	if (hFile == INVALID_HANDLE_VALUE) {
+		*sectsize = 512;
+		return 0;
+	}
+	memset(&query, 0, sizeof(query));
+	query.PropertyId = StorageAccessAlignmentProperty;
+	query.QueryType  = PropertyStandardQuery;
+	if (DeviceIoControl(hFile,
+	                    IOCTL_STORAGE_QUERY_PROPERTY,
+	                    &query, sizeof(query),
+	                    &alignment, sizeof(alignment),
+	                    &bytes_returned, NULL)) {
+		*sectsize = (int)alignment.BytesPerLogicalSector;
+		if (*sectsize <= 0)
+			*sectsize = 512;
+	} else {
+		*sectsize = 512;
+	}
+	CloseHandle(hFile);
+	return 0;
+#endif /* _WIN32 */
+
 #ifdef BLKSSZGET
 	fd = open(file, O_RDONLY);
 	if (fd == -1)
@@ -55,6 +98,35 @@ int ext2fs_get_device_sectsize(const char *file, int *sectsize)
